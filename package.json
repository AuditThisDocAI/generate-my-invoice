    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.0.0",
    "firebase-functions": "^7.3.2-rc.0",
    "framer-motion": "^11.11.17",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
